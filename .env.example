# ACF BACKEND — RUNTIME ENVIRONMENT
#
# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
#
# Every contract address below is a POST-DEPLOYMENT value: take it from the smart-contract
# repository's deployments/<chainId>/ records after Stage 5B. No address is hardcoded in
# source, and none is carried over from a superseded deployment.
#
# NETWORK PORTABILITY: moving Amoy -> Polygon mainnet is CHAIN_ID + RPC_URL + the fresh
# addresses + a fresh MONGODB_URI. No source change.
#
# Legend:  [REQUIRED] fails at boot if absent      [OPTIONAL] real source default shown
#          [SECRET] never commit, never log        [CUTOVER] chosen after deployment


# ═══════════════════════════════════════════════════════════════════════════════
# NETWORK
# ═══════════════════════════════════════════════════════════════════════════════

# [REQUIRED] 80002 = Polygon Amoy, 137 = Polygon mainnet.
# Included in the signed login message, so a signature cannot be replayed on another chain.
CHAIN_ID=80002

# [REQUIRED] Must point at the SAME network as CHAIN_ID.
# The API and the reward worker never sign — they only read contract state and events.
RPC_URL=<RPC_ENDPOINT_FOR_CHAIN_ID>


# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════════════════

# [REQUIRED] A FRESH database for a fresh deployment. Do NOT migrate historical financial
# rows from a pre-launch database: claimed amounts, epochs and referral edges there belong
# to contracts that no longer exist.
#
# A fresh database contains no logical ROOT, so the wallet that
# ACFWithdrawal.currentRootEOA() names must register FIRST. Until it does, every other
# registration is refused with 503 REFERRAL_ROOT_UNAVAILABLE, by design.
MONGODB_URI=<FRESH_MONGODB_URI>

# [OPTIONAL, tests only] Integration tests connect ONLY to this, never to MONGODB_URI,
# because they delete every document between cases. Leave unset to skip them.
# The database name MUST contain "test" or the suite refuses to run.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/acf_user_test


# ═══════════════════════════════════════════════════════════════════════════════
# HTTP / CORS
# ═══════════════════════════════════════════════════════════════════════════════

# [REQUIRED] No default — the port is never guessed.
PORT=3001

# [REQUIRED] Allowed browser origins, comma-separated. Each must match a deployed frontend's
# own VITE_PUBLIC_APP_ORIGIN.
#
# An ORIGIN is scheme + host + port with NO path and NO trailing slash — the browser sends
# `http://localhost:5173`, so `http://localhost:5173/` would never match. A trailing slash is
# stripped automatically, and anything else malformed fails loudly at boot rather than
# silently blocking one site in production.
#
#   CORS_ORIGIN=http://localhost:5173
#   CORS_ORIGIN=https://app.example.com,https://staging.example.com
#
# Requests with no Origin at all (curl, health checks, server-to-server) are allowed: CORS is a
# browser protection, and rejecting those would break tooling without protecting anything.
CORS_ORIGIN=http://localhost:5173

# [OPTIONAL, default "development"]
NODE_ENV=development

# [OPTIONAL, default "info"] debug | info | warn | error.
# "debug" is noisy; "warn" hides successful requests.
LOG_LEVEL=info


# ═══════════════════════════════════════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════════════════════════════════════

# [REQUIRED] [SECRET] A long random value — never a memorable string. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# In production inject it from a secret manager rather than writing it to disk.
JWT_SECRET=<SECRET>

# [REQUIRED] Session lifetime in seconds. 86400 = 24h.
JWT_EXPIRES_IN_SECONDS=86400

# [REQUIRED] How long a login challenge stays valid, in seconds.
CHALLENGE_TTL_SECONDS=300


# ═══════════════════════════════════════════════════════════════════════════════
# CONTRACT ADDRESSES  —  all [REQUIRED], all from deployments/<chainId>/
# ═══════════════════════════════════════════════════════════════════════════════
#
# Startup CROSS-VERIFIES these against each other on chain and refuses to run on any
# mismatch — ACFStaking.acf() must equal ACF_TOKEN_ADDRESS, and ACFBond's
# acf()/usdt()/staking()/swap() must all match what is configured here. A stale proxy with
# plausible-looking state but a dead token is caught at boot rather than in production.

# ACFToken.proxy
ACF_TOKEN_ADDRESS=<DEPLOYED_ACF_TOKEN_PROXY>

# MockUSDT (testnet) or real USDT (mainnet) — whichever the protocol was deployed against.
MOCK_USDT_ADDRESS=<DEPLOYED_USDT>

# ACFStaking.proxy
ACF_STAKING_ADDRESS=<DEPLOYED_ACF_STAKING_PROXY>

# UniswapACFSwap.proxy — swap records are verified against logs from this address.
ACF_SWAP_ADDRESS=<DEPLOYED_ACF_SWAP_PROXY>

# ACFBond.proxy
ACF_BOND_ADDRESS=<DEPLOYED_ACF_BOND_PROXY>

# ACFDAO.proxy
ACF_DAO_ADDRESS=<DEPLOYED_ACF_DAO_PROXY>

# ACFTreasury.proxy
TREASURY_ADDRESS=<DEPLOYED_TREASURY_PROXY>

# ACFWithdrawal.proxy — also the ONLY source of the referral root, see below.
WITHDRAWAL_ADDRESS=<DEPLOYED_WITHDRAWAL_PROXY>

# ACFDAORevenueDistributor.proxy
DAO_REVENUE_DISTRIBUTOR_ADDRESS=<DEPLOYED_DAO_REVENUE_DISTRIBUTOR_PROXY>

# NOT configured here: ACFRootRewardSplitter, CreatorFeeCollector and the ALS. The backend
# never calls them — ROOT reward routing happens entirely inside ACFWithdrawal.

# [OPTIONAL, default 1] Confirmations before a swap is recorded; a mined tx counts as 1.
# The receipt is already proof of inclusion, and a reorg here costs only a row that can be
# re-recorded from the same hash. Raising it makes the client retry rather than lose the record.
SWAP_CONFIRMATIONS=1


# ═══════════════════════════════════════════════════════════════════════════════
# REFERRAL ROOT  —  there is deliberately NO root address variable
# ═══════════════════════════════════════════════════════════════════════════════
#
# ACFWithdrawal.currentRootEOA() is the ONLY authority for which wallet the referral root is
# bound to, because that is where ROOT rotation happens. A value configured here could only
# ever be a stale second opinion, and the two disagreeing would decide who a user's sponsor
# is or who a reward belongs to.
#
# The backend reads it through WITHDRAWAL_ADDRESS and RPC_URL above, which is all the
# configuration this needs.
#
# ROOT_ADMIN_EOA exists ONLY in the smart-contract repository's deployment configuration,
# where it supplies ACFWithdrawal's initial ROOT. It is NOT a backend variable — do not add it.


# ═══════════════════════════════════════════════════════════════════════════════
# REWARD CUTOVER  —  [CUTOVER] both chosen AFTER deployment
# ═══════════════════════════════════════════════════════════════════════════════
#
# Epochs are twelve hours: epochId = floor(unixSeconds / 43200), so epochId * 43200 is always
# a 00:00 or 12:00 UTC boundary. An epoch settles the window that JUST COMPLETED: epoch N
# covers [N*43200 - 43200, N*43200).
#
#   today's:  node -e "console.log(Math.floor(Date.now()/1000/43200))"
#
# Choose the first boundary AFTER the cutover is complete — after the ROOT has registered,
# the Swap is seeded and smoke tests pass. For a fresh deployment both normally take the
# same value.
#
# ⚠ WORKERS MUST STAY STOPPED until both are set.

# [REQUIRED] The first epoch the engine may settle. Epochs before it produce no reward, ever.
# Without it a first run would backfill every window since deployment and invent months of
# liability nobody agreed to.
REWARD_ENGINE_ACTIVATION_EPOCH=<SET_AT_CUTOVER>

# [REQUIRED] The first epoch settled under the registered-EOA direct rule. It decides Level
# unlock depth and the Rank direct requirement, so a wrong value silently changes everyone's
# team mathematics. Absent or non-integer fails at boot rather than inventing a cutover.
REGISTERED_EOA_DIRECT_RULE_START_EPOCH=<SET_AT_CUTOVER>

# [OPTIONAL] A granted MINIMUM rank for the logical referral ROOT — the one parentless user,
# which every registration without a referral code attaches to. 0 (the default) grants nothing.
#
# Rank is otherwise recomputed from stake and directs EVERY epoch and is never stored, so this
# is a grant rather than a cached rank. It is written onto the ROOT's own user document at its
# first registration and read from there afterwards; changing this variable later does NOT move
# an already-registered ROOT, which is deliberate — a settled epoch must not be repriced by an
# edit to a config file. To change an existing grant, edit `rankFloor` on that one document.
#
# It is honoured for `graph.rootUserId` ALONE. Ranks 7-12 qualify on DESCENDANTS' ranks and the
# root is nobody's descendant, so raising it cannot move any other user's rank or payout. That
# guarantee holds for no other node, which is why no other node may be granted one.
#
# ⚠ It raises TWO payout channels, not one. Rank income is capped per tier (rank 12 = $75,000
#   per 12-hour epoch). The GLOBAL pool is NOT capped and multiplies linearly by rank number:
#   selfStake x l1Stake x rank / networkContribution. Both are funded by the Treasury.
#
# 12 = EternalX, the highest of the twelve tiers. 7 = Quantum.
ROOT_RANK_FLOOR=12


# ═══════════════════════════════════════════════════════════════════════════════
# REWARD ENGINE TUNING  —  all [OPTIONAL], source defaults shown
# ═══════════════════════════════════════════════════════════════════════════════

# Cron for the calculation worker, UTC. Epochs are keyed by time, so running more often only
# re-checks for work — it cannot create extra epochs or double-pay anything.
REWARD_WORKER_CRON=5 0,12 * * *

# Bounded page sizes. Conservative by default; financial correctness over throughput.
REWARD_STAKE_PAGE_SIZE=200
REWARD_MULTICALL_BATCH=100

# Ceiling on the as-of referral graph a Team Reward epoch will load. Exceeding it FAILS the
# epoch; it never truncates, because Rank is computed from the entire downline and a partial
# graph would silently understate someone's team.
REWARD_PHASE2_MAX_GRAPH_NODES=100000

# How long a worker may own a PROCESSING Team Reward epoch before another may reclaim it.
REWARD_PHASE2_LEASE_MS=1800000

# Phase 3 settlement lease, and how many epoch proof sets are cached in memory.
SETTLEMENT_LEASE_MS=900000
SETTLEMENT_PROOF_CACHE_SIZE=4

# Phase 4 DAO revenue: members per distributeBatch call, and the calculation/execution leases.
DAO_REVENUE_BATCH_SIZE=50
DAO_REVENUE_LEASE_MS=900000
DAO_REVENUE_EXECUTOR_LEASE_MS=1200000
DAO_REVENUE_EXECUTOR_POLL_MS=60000

# Block span per getLogs chunk when reading DAO config history. Small on purpose: public RPC
# providers cap log ranges.
DAO_CONFIG_LOG_CHUNK_BLOCKS=10


# ═══════════════════════════════════════════════════════════════════════════════
# EXECUTOR SIGNING KEY  —  A RELAY KEY, NOT A PAYOUT AUTHORITY
# ═══════════════════════════════════════════════════════════════════════════════
#
# [SECRET] Set this ONLY in the environment of the executor processes:
#   npm run settlement:execute     Treasury.fundRewardEpoch, Withdrawal.finalizeEpoch
#   npm run dao-revenue:execute    Treasury.fundDAORevenueEpoch, Distributor.distributeBatch,
#                                  Distributor.payMarketing
#
# IT CAN ONLY RELAY, IN BOTH PHASES. What each epoch may pay is committed on chain beforehand by
# the SEPARATE authorizer key below, which this key cannot reach.
#
#   Phase 4   the member Merkle root, the member total, the marketing recipient and its amount.
#             Funding is refused unless it equals the authorized total exactly, every member
#             transfer must carry a proof against the authorized root, and payMarketing takes
#             nothing but an epoch id.
#   Phase 3   the cumulative Merkle root, the cumulative total entitlement and the exact Treasury
#             funding. fundRewardEpoch and finalizeEpoch take an epoch id and NOTHING else: the
#             amount is read from the commitment and the root comes from it, so this key chooses
#             neither. Before that split (audit finding C-01) this key alone could fund an
#             arbitrary amount against a Merkle root paying itself, and claim the proceeds.
#
# Leave it UNSET for the API and the reward worker: neither can reach the signer module, and
# both run perfectly without it. The account needs EPOCH_EXECUTOR_ROLE on Treasury, Withdrawal
# and the DAO revenue distributor, plus native POL for gas — never ACF.
#
# NEVER the admin/deployer key: that one also carries DEFAULT_ADMIN and UPGRADER over the whole
# protocol, so a compromise of this host would become full control of the Treasury.
#
# Left deliberately empty. In production inject it from a secret manager at boot rather than
# writing it to disk; a raw key in an environment variable is the WEAKEST acceptable option.
EPOCH_EXECUTOR_PRIVATE_KEY=

# [OPTIONAL, deprecated] Legacy alias still accepted by the signer for an existing deployment.
# Prefer EPOCH_EXECUTOR_PRIVATE_KEY above; do not set both.
# DAO_REVENUE_EXECUTOR_PRIVATE_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# AUTHORIZER SIGNING KEY  —  DECIDES WHAT IS PAYABLE, IN BOTH PHASES
# ═══════════════════════════════════════════════════════════════════════════════
#
# [SECRET] Set this ONLY in the environment of the two authorize steps:
#   npm run dao-revenue:authorize    Distributor.authorizeEpoch
#   npm run settlement:authorize     Withdrawal.authorizeRewardEpoch
#
# ONE KEY, TWO DISTINCT ON-CHAIN ROLES. The same account holds DAO_REVENUE_AUTHORIZER_ROLE on the
# distributor and REWARD_AUTHORIZER_ROLE on the Withdrawal. The roles are deliberately NOT merged
# in the contracts; sharing the key is a custody decision, because both roles ask the same
# question of the same kind of key — "is this payable set the one the backend actually
# calculated?" — and that key is already custodied apart from the executor. A third signing
# identity for the same duty would be one more key to fund, rotate and lose, with no authority it
# does not already have.
#
# To separate them later, set REWARD_AUTHORIZER_PRIVATE_KEY (below) and grant
# REWARD_AUTHORIZER_ROLE to that account instead. Nothing else changes.
#
# ⚠ A DIFFERENT ACCOUNT FROM EPOCH_EXECUTOR_PRIVATE_KEY ABOVE.
#
# The signer module refuses to build if the two resolve to the same account, and both
# ACFDAORevenueDistributor.initialize and ACFWithdrawal.configureRewardAuthorization refuse the
# collapsed role on chain — because one key holding both halves could authorize an attacker's
# payable set and then relay it, which is exactly the authority the split removes. For Phase 3
# that means publishing a Merkle root paying itself the funded Treasury amount: audit finding
# C-01, and the reason this separation is not optional.
#
# NO PROCESS NEEDS BOTH KEYS. Both names are documented here so the contract is explicit, but
# in production they SHOULD NOT be loaded into the same process or the same secret scope.
# Co-locating them in one secret store, one host or one KMS principal recreates the single
# point of failure the on-chain separation closed.
#
# The account needs DAO_REVENUE_AUTHORIZER_ROLE on the distributor, REWARD_AUTHORIZER_ROLE on the
# Withdrawal, and native POL for gas — never ACF, and never any other role. It cannot move a
# token in either phase: it commits what is payable and the executor relays it.
#
# Left deliberately empty. In production inject it from a secret manager at boot.
DAO_REVENUE_AUTHORIZER_PRIVATE_KEY=

# [OPTIONAL] Separates the Phase 3 authorizer from the Phase 4 one.
#
# Unset, `npm run settlement:authorize` uses DAO_REVENUE_AUTHORIZER_PRIVATE_KEY above, which is
# the intended configuration. Set it to give Phase 3 its own key; grant REWARD_AUTHORIZER_ROLE to
# that account, and it is still refused if it equals EPOCH_EXECUTOR_PRIVATE_KEY.
# REWARD_AUTHORIZER_PRIVATE_KEY=
